# chat-digest first-run answers (data only, never executed as shell).
# cp examples/install.env.example /tmp/chat-digest-install.env
# chmod 600 /tmp/chat-digest-install.env
# ./install.sh --config /tmp/chat-digest-install.env
# MODE=demo: offline fictional data; no account, model key or Docker required.
MODE=demo
# For real deployment set MODE=real and fill all six fields below.
EXPORT_ROOT=/srv/chat-export
CONVERSATION_ID=synthetic-conversation
GROUP_NAME='示例学习小组'
MODEL_BASE_URL=https://api.example.invalid/v1
MODEL_API_KEY='REPLACE_WITH_PRIVATE_API_KEY'
MODEL_NAME='REPLACE_WITH_OPENAI_COMPATIBLE_MODEL'
# At least 8 characters; blank generates a password shown only once.
SITE_PASSWORD=''
