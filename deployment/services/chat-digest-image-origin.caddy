# Example only: route report image requests to the loopback image origin on the machine that keeps the originals.
# IMAGE_ORIGIN_HOST and the imported auth snippet are yours to define; the snippet adds the Bearer token header.
@origin_image path_regexp origin_image ^/assets/[0-9a-f]{64}\.(png|jpg|jpeg|gif|webp)$
handle @origin_image {
    reverse_proxy https://{$IMAGE_ORIGIN_HOST} {
        header_up Host {$IMAGE_ORIGIN_HOST}
        header_up -Cookie
        import /etc/caddy/chat-digest/image-origin-auth.caddy
        transport http {
            dial_timeout 10s
            response_header_timeout 20s
        }
    }
}
handle {
    file_server
}
