#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1


SERVICE_ROOT=${CHAT_DIGEST_ROOT:-/opt/chat-digest}
PROGRAM=$SERVICE_ROOT/deployment/realtime-images.py
PYTHON=${CHAT_DIGEST_PYTHON:-/usr/bin/python3}
start_service() {
	[ -x "$PYTHON" ] || return 1
	[ -f "$PROGRAM" ] || return 1
	procd_open_instance
	procd_set_param command "$PYTHON" "$PROGRAM" --serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
