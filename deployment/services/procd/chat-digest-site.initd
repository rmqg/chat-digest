#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

SERVICE_ROOT=${CHAT_DIGEST_ROOT:-/opt/chat-digest}
PROGRAM=$SERVICE_ROOT/deployment/local_site.py
CONFIG=${CHAT_DIGEST_SITE_CONFIG:-$SERVICE_ROOT/runtime/local-site.json}
PYTHON=${CHAT_DIGEST_PYTHON:-/usr/bin/python3}

start_service() {
	[ -x "$PYTHON" ] || return 1
	[ -f "$PROGRAM" ] || return 1
	[ -f "$CONFIG" ] || return 1
	"$PYTHON" "$PROGRAM" --config "$CONFIG" --check-config || return 1
	procd_open_instance
	procd_set_param command "$PYTHON" "$PROGRAM" --config "$CONFIG" --serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
